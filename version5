# =========================================================
#  SMART CSV READER
# =========================================================
def smart_read_csv(path):
    """
    Reads a CSV that may have junk header lines like:
        /*=========================
         col1, col2, col3
         =========================*/
    Strategy:
      1. Read raw lines.
      2. Strip lines that are pure junk: /* ... */, ====, blank, etc.
      3. Find the first 'real' header row — the one with the most
         comma-separated, alphanumeric tokens.
      4. Feed the cleaned text to pandas.
    """
    with open(path, "r", encoding="utf-8-sig", errors="replace", newline="") as f:
        raw_lines = f.readlines()

    junk_pattern = re.compile(
        r"^\s*(/\*+|\*+/|=+|-+|#+|//+)?\s*$"  # pure decoration / blank
    )

    cleaned = []
    for line in raw_lines:
        stripped = line.strip()
        if not stripped:
            continue
        # Drop lines that are only made of decoration chars
        if re.fullmatch(r"[/*=\-#\s]+", stripped):
            continue
        # Drop block-comment open/close lines that have no real data
        if stripped.startswith("/*") and "," not in stripped:
            continue
        if stripped.endswith("*/") and "," not in stripped:
            continue
        # Strip leading /* and trailing */ if present on a data line
        line2 = re.sub(r"^/\*+\s*", "", line)
        line2 = re.sub(r"\s*\*+/\s*$", "", line2)
        # Strip leading/trailing decoration chars on the line
        line2 = re.sub(r"^[=\-*#/\s]+", "", line2)
        line2 = re.sub(r"[=\-*#/\s]+$", "", line2) + "\n"
        if line2.strip():
            cleaned.append(line2)

    if not cleaned:
        # Fallback: just let pandas try
        return pd.read_csv(path)

    cleaned_text = "".join(cleaned)

    # Use csv.Sniffer to detect delimiter (default comma)
    try:
        dialect = csv.Sniffer().sniff(cleaned_text[:2048], delimiters=",;\t|")
        sep = dialect.delimiter
    except Exception:
        sep = ","

    from io import StringIO
    df = pd.read_csv(StringIO(cleaned_text), sep=sep, engine="python")

    # Clean column names: strip whitespace, decoration, quotes
    df.columns = [
        re.sub(r"^[=\-*#/\s\"']+|[=\-*#/\s\"']+$", "", str(c)).strip()
        for c in df.columns
    ]
    # Drop fully empty columns that sometimes appear from trailing commas
    df = df.dropna(axis=1, how="all")
    # Drop unnamed columns
    df = df.loc[:, [c for c in df.columns if c and not str(c).lower().startswith("unnamed")]]
    return df


# =========================================================
#  ROUNDED-LOOK BUTTON HELPER
# =========================================================
class FlatButton(Button):
    def __init__(self, master, text, command=None, kind="primary", **kw):
        palette = {
            "primary": (COLORS["accent"], COLORS["accent_hov"], "white"),
            "success": (COLORS["success"], COLORS["success_hov"], "white"),
            "ghost":   (COLORS["panel_alt"], COLORS["border"], COLORS["text"]),
            "danger":  (COLORS["danger"], "#f87171", "white"),
        }
        bg, hov, fg = palette.get(kind, palette["primary"])
        super().__init__(
            master, text=text, command=command,
            bg=bg, fg=fg, activebackground=hov, activeforeground=fg,
            font=FONTS["btn"], relief="flat", bd=0,
            padx=16, pady=8, cursor="hand2", **kw
        )
        self._bg = bg
        self._hov = hov
        self.bind("<Enter>", lambda e: self.config(bg=self._hov))
        self.bind("<Leave>", lambda e: self.config(bg=self._bg))


# =========================================================
#  MAIN APP
# =========================================================
class ProfessionalAuditor:
    def __init__(self, root):
        self.root = root
        self.root.title("Version Sync & Auditor")
        self.root.geometry("1440x920")
        self.root.configure(bg=COLORS["bg"])
        self.root.minsize(1100, 700)

        self.loaded_data = {}   # {filename: DataFrame}

        self._configure_ttk_style()
        self._build_ui()

    # -----------------------------------------------------
    def _configure_ttk_style(self):
        style = ttk.Style()
        try:
            style.theme_use("clam")
        except Exception:
            pass

        # Combobox
        style.configure(
            "Modern.TCombobox",
            fieldbackground=COLORS["panel_alt"],
            background=COLORS["panel_alt"],
            foreground=COLORS["text"],
            arrowcolor=COLORS["text"],
            bordercolor=COLORS["border"],
            lightcolor=COLORS["border"],
            darkcolor=COLORS["border"],
            padding=6,
        )
        style.map(
            "Modern.TCombobox",
            fieldbackground=[("readonly", COLORS["panel_alt"])],
            foreground=[("readonly", COLORS["text"])],
            background=[("readonly", COLORS["panel_alt"])],
        )
        self.root.option_add("*TCombobox*Listbox.background", COLORS["panel"])
        self.root.option_add("*TCombobox*Listbox.foreground", COLORS["text"])
        self.root.option_add("*TCombobox*Listbox.selectBackground", COLORS["accent"])
        self.root.option_add("*TCombobox*Listbox.selectForeground", "white")
        self.root.option_add("*TCombobox*Listbox.font", FONTS["body"])

        # Treeview
        style.configure(
            "Modern.Treeview",
            background=COLORS["panel"],
            fieldbackground=COLORS["panel"],
            foreground=COLORS["text"],
            bordercolor=COLORS["border"],
            rowheight=26,
            font=FONTS["body"],
        )
        style.configure(
            "Modern.Treeview.Heading",
            background=COLORS["panel_alt"],
            foreground=COLORS["text"],
            font=FONTS["h2"],
            relief="flat",
            padding=8,
        )
        style.map(
            "Modern.Treeview",
            background=[("selected", COLORS["accent"])],
            foreground=[("selected", "white")],
        )
        style.map(
            "Modern.Treeview.Heading",
            background=[("active", COLORS["border"])],
        )

        # Scrollbars
        style.configure(
            "Modern.Vertical.TScrollbar",
            background=COLORS["panel_alt"],
            troughcolor=COLORS["bg"],
            bordercolor=COLORS["bg"],
            arrowcolor=COLORS["text_dim"],
        )
        style.configure(
            "Modern.Horizontal.TScrollbar",
            background=COLORS["panel_alt"],
            troughcolor=COLORS["bg"],
            bordercolor=COLORS["bg"],
            arrowcolor=COLORS["text_dim"],
        )

    # -----------------------------------------------------
    def _card(self, parent, **pack_kw):
        """A panel with a subtle border."""
        outer = Frame(parent, bg=COLORS["border"])
        outer.pack(**pack_kw)
        inner = Frame(outer, bg=COLORS["panel"], padx=14, pady=12)
        inner.pack(fill=BOTH, expand=True, padx=1, pady=1)
        return inner

    def _label(self, parent, text, font=None, fg=None):
        return Label(
            parent, text=text,
            bg=parent.cget("bg"),
            fg=fg or COLORS["text"],
            font=font or FONTS["body"],
            anchor=W, justify="left",
        )

    # -----------------------------------------------------
    def _build_ui(self):
        # Header
        header = Frame(self.root, bg=COLORS["bg"])
        header.pack(fill=X, padx=20, pady=(18, 6))
        Label(
            header, text="⚡  Version Sync & Auditor",
            bg=COLORS["bg"], fg=COLORS["text"], font=FONTS["title"]
        ).pack(side=LEFT)
        Label(
            header,
            text="Compare CSV exports across versions and surface every variance.",
            bg=COLORS["bg"], fg=COLORS["text_dim"], font=FONTS["small"]
        ).pack(side=LEFT, padx=(14, 0), pady=(6, 0))

        body = Frame(self.root, bg=COLORS["bg"])
        body.pack(fill=BOTH, expand=True, padx=20, pady=10)

        # --- STEP 1 CARD: Load & select ---
        card1 = self._card(body, fill=X, pady=(0, 12))
        self._label(card1, "STEP 1   ·   Load & Select Files",
                    font=FONTS["h2"], fg=COLORS["accent"]).pack(fill=X, pady=(0, 8))

        row1 = Frame(card1, bg=COLORS["panel"])
        row1.pack(fill=X)

        FlatButton(row1, "📂  Load CSV Files",
                   command=self.handle_file_loading, kind="primary").pack(side=LEFT, padx=(0, 16))

        self._label(row1, "Base File", font=FONTS["small"], fg=COLORS["text_dim"]).pack(side=LEFT, padx=(4, 6))
        self.base_file_var = StringVar()
        self.base_file_combo = ttk.Combobox(
            row1, textvariable=self.base_file_var, state="readonly",
            width=32, style="Modern.TCombobox", font=FONTS["body"]
        )
        self.base_file_combo.pack(side=LEFT, padx=(0, 16))
        self.base_file_combo.bind("<<ComboboxSelected>>", lambda e: self.sync_interface())

        self._label(row1, "Upgraded File", font=FONTS["small"], fg=COLORS["text_dim"]).pack(side=LEFT, padx=(4, 6))
        self.upgrade_file_var = StringVar()
        self.upgrade_file_combo = ttk.Combobox(
            row1, textvariable=self.upgrade_file_var, state="readonly",
            width=32, style="Modern.TCombobox", font=FONTS["body"]
        )
        self.upgrade_file_combo.pack(side=LEFT)
        self.upgrade_file_combo.bind("<<ComboboxSelected>>", lambda e: self.sync_interface())

        # --- DUAL PREVIEW CARD ---
        prev_card = self._card(body, fill=X, pady=(0, 12))
        self._label(prev_card, "PREVIEW   ·   Top 5 Rows",
                    font=FONTS["h2"], fg=COLORS["accent"]).pack(fill=X, pady=(0, 8))

        prev_row = Frame(prev_card, bg=COLORS["panel"])
        prev_row.pack(fill=BOTH, expand=True)

        base_box = Frame(prev_row, bg=COLORS["panel"])
        base_box.pack(side=LEFT, fill=BOTH, expand=True, padx=(0, 6))
        self._label(base_box, "Base", font=FONTS["small"], fg=COLORS["text_dim"]).pack(fill=X, pady=(0, 4))
        self.base_tree = self._make_tree(base_box, height=5)

        up_box = Frame(prev_row, bg=COLORS["panel"])
        up_box.pack(side=LEFT, fill=BOTH, expand=True, padx=(6, 0))
        self._label(up_box, "Upgraded", font=FONTS["small"], fg=COLORS["text_dim"]).pack(fill=X, pady=(0, 4))
        self.upgrade_tree = self._make_tree(up_box, height=5)

        # --- STEP 2 CARD: Mapping ---
        card2 = self._card(body, fill=X, pady=(0, 12))
        self._label(card2, "STEP 2   ·   Map Columns for Comparison",
                    font=FONTS["h2"], fg=COLORS["accent"]).pack(fill=X, pady=(0, 8))

        map_row = Frame(card2, bg=COLORS["panel"])
        map_row.pack(fill=X, pady=(0, 8))

        self.base_col_var = StringVar()
        self.upgrade_col_var = StringVar()
        self.base_col_picker = ttk.Combobox(
            map_row, textvariable=self.base_col_var, state="readonly",
            width=38, style="Modern.TCombobox", font=FONTS["body"]
        )
        self.upgrade_col_picker = ttk.Combobox(
            map_row, textvariable=self.upgrade_col_var, state="readonly",
            width=38, style="Modern.TCombobox", font=FONTS["body"]
        )

        self.base_col_picker.pack(side=LEFT)
        Label(map_row, text="→", bg=COLORS["panel"],
              fg=COLORS["accent"], font=("Segoe UI", 14, "bold")).pack(side=LEFT, padx=10)
        self.upgrade_col_picker.pack(side=LEFT, padx=(0, 14))

        FlatButton(map_row, "＋ Add Pair",
                   command=self.add_mapping_row, kind="primary").pack(side=LEFT, padx=(0, 8))
        FlatButton(map_row, "✕ Remove Selected",
                   command=self.remove_mapping_row, kind="ghost").pack(side=LEFT)

        # mapping table
        map_table_wrap = Frame(card2, bg=COLORS["border"])
        map_table_wrap.pack(fill=X)
        map_table_inner = Frame(map_table_wrap, bg=COLORS["panel"])
        map_table_inner.pack(fill=BOTH, expand=True, padx=1, pady=1)

        self.mapping_tree = ttk.Treeview(
            map_table_inner, columns=("base", "upgrade"),
            show="headings", height=4, style="Modern.Treeview"
        )
        self.mapping_tree.heading("base", text="Base Column")
        self.mapping_tree.heading("upgrade", text="Upgraded Column")
        self.mapping_tree.column("base", anchor=W, width=600)
        self.mapping_tree.column("upgrade", anchor=W, width=600)
        self.mapping_tree.pack(fill=X, expand=True)

        # --- CONSOLE + RUN ---
        bottom = Frame(body, bg=COLORS["bg"])
        bottom.pack(fill=BOTH, expand=True)

        log_card = self._card(bottom, fill=BOTH, expand=True, pady=(0, 12))
        self._label(log_card, "CONSOLE",
                    font=FONTS["h2"], fg=COLORS["accent"]).pack(fill=X, pady=(0, 6))
        self.console_log = ScrolledText(
            log_card, height=10,
            bg=COLORS["console_bg"], fg=COLORS["console_fg"],
            insertbackground=COLORS["console_fg"],
            font=FONTS["mono"], relief="flat", bd=0,
            padx=10, pady=8,
        )
        self.console_log.pack(fill=BOTH, expand=True)
        self.log("System ready. Load CSV files to begin.")

        run_btn = FlatButton(
            body, "▶  STEP 3   ·   RUN COMPARISON & GENERATE EXCEL REPORT",
            command=self.run_audit_process, kind="success"
        )
        run_btn.configure(font=FONTS["btn_lg"], pady=14)
        run_btn.pack(fill=X, pady=(0, 4))

    def _make_tree(self, parent, height=5):
        wrap_outer = Frame(parent, bg=COLORS["border"])
        wrap_outer.pack(fill=BOTH, expand=True)
        wrap = Frame(wrap_outer, bg=COLORS["panel"])
        wrap.pack(fill=BOTH, expand=True, padx=1, pady=1)

        tree = ttk.Treeview(wrap, show="headings", height=height, style="Modern.Treeview")
        vsb = ttk.Scrollbar(wrap, orient="vertical",
                            command=tree.yview, style="Modern.Vertical.TScrollbar")
        hsb = ttk.Scrollbar(wrap, orient="horizontal",
                            command=tree.xview, style="Modern.Horizontal.TScrollbar")
        tree.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
        tree.grid(row=0, column=0, sticky=N + S + E + W)
        vsb.grid(row=0, column=1, sticky=N + S)
        hsb.grid(row=1, column=0, sticky=E + W)
        wrap.rowconfigure(0, weight=1)
        wrap.columnconfigure(0, weight=1)
        return tree

    # -----------------------------------------------------
    def log(self, msg, level="info"):
        prefix = {
            "info":    "  ",
            "ok":      "✔ ",
            "warn":    "⚠ ",
            "err":     "✖ ",
        }.get(level, "  ")
        ts = datetime.now().strftime("%H:%M:%S")
        self.console_log.insert(END, f"[{ts}] {prefix}{msg}\n")
        self.console_log.see(END)

    # -----------------------------------------------------
    def handle_file_loading(self):
        files = filedialog.askopenfilenames(
            title="Select CSV Files",
            filetypes=[("CSV Files", "*.csv"), ("All Files", "*.*")]
        )
        if not files:
            return

        self.loaded_data.clear()
        for f in files:
            name = os.path.basename(f)
            try:
                df = smart_read_csv(f)
                self.loaded_data[name] = df
                self.log(f"Loaded {name}  →  {df.shape[0]} rows × {df.shape[1]} cols", "ok")
                self.log(f"  Columns: {', '.join(map(str, df.columns[:8]))}"
                         + (" ..." if len(df.columns) > 8 else ""))
            except Exception as e:
                self.log(f"Failed to load {name}: {e}", "err")

        names = list(self.loaded_data.keys())
        self.base_file_combo["values"] = names
        self.upgrade_file_combo["values"] = names

        if len(names) >= 1:
            self.base_file_combo.current(0)
        if len(names) >= 2:
            self.upgrade_file_combo.current(1)
        elif len(names) == 1:
            self.upgrade_file_combo.current(0)

        self.sync_interface()

    def sync_interface(self):
        base_name = self.base_file_var.get()
        up_name = self.upgrade_file_var.get()

        self._populate_preview(base_name, self.base_tree)
        self._populate_preview(up_name, self.upgrade_tree)

        if base_name in self.loaded_data:
            cols_b = [str(c) for c in self.loaded_data[base_name].columns]
            self.base_col_picker["values"] = cols_b
            if cols_b:
                self.base_col_picker.current(0)

        if up_name in self.loaded_data:
            cols_u = [str(c) for c in self.loaded_data[up_name].columns]
            self.upgrade_col_picker["values"] = cols_u
            if cols_u:
                self.upgrade_col_picker.current(0)

    def _populate_preview(self, name, tree):
        for item in tree.get_children():
            tree.delete(item)
        tree["columns"] = ()

        if name not in self.loaded_data:
            return

        df = self.loaded_data[name].head(5)
        cols = [str(c) for c in df.columns]
        tree["columns"] = cols
        for c in cols:
            tree.heading(c, text=c)
            tree.column(c, width=140, anchor=W, stretch=False)

        for _, row in df.iterrows():
            tree.insert("", END, values=[str(v) for v in row.tolist()])

    def add_mapping_row(self):
        b_col = self.base_col_var.get()
        u_col = self.upgrade_col_var.get()
        if b_col and u_col:
            self.mapping_tree.insert("", END, values=(b_col, u_col))
            self.log(f"Mapping added: {b_col}  →  {u_col}")

    def remove_mapping_row(self):
        sel = self.mapping_tree.selection()
        if not sel:
            self.log("No mapping selected to remove.", "warn")
            return
        for s in sel:
            self.mapping_tree.delete(s)
        self.log(f"Removed {len(sel)} mapping(s).")

    # -----------------------------------------------------
    def run_audit_process(self):
        b_name = self.base_file_var.get()
        u_name = self.upgrade_file_var.get()

        if not b_name or not u_name:
            self.log("Please select both Base and Upgraded files.", "err")
            return

        mappings = []
        for iid in self.mapping_tree.get_children():
            vals = self.mapping_tree.item(iid, "values")
            mappings.append((vals[0], vals[1]))

        if not mappings:
            self.log("No column mappings defined.", "err")
            return

        try:
            df_b = self.loaded_data[b_name].copy()
            df_u = self.loaded_data[u_name].copy()

            # Drop fully-empty rows but DON'T blanket-dropna (kills too much data)
            df_b = df_b.dropna(how="all")
            df_u = df_u.dropna(how="all")

            id_col_b, id_col_u = df_b.columns[0], df_u.columns[0]
            self.log(f"Using primary key  ·  Base: '{id_col_b}'  |  Upgraded: '{id_col_u}'")

            df_b[id_col_b] = df_b[id_col_b].astype(str).str.strip()
            df_u[id_col_u] = df_u[id_col_u].astype(str).str.strip()

            keys_b = set(df_b[id_col_b])
            keys_u = set(df_u[id_col_u])

            missing = pd.DataFrame({"Missing_in_Upgraded": sorted(keys_b - keys_u)})
            new_items = pd.DataFrame({"New_in_Upgraded": sorted(keys_u - keys_b)})

            common_ids = keys_b & keys_u
            df_b_idx = df_b[df_b[id_col_b].isin(common_ids)].drop_duplicates(id_col_b).set_index(id_col_b)
            df_u_idx = df_u[df_u[id_col_u].isin(common_ids)].drop_duplicates(id_col_u).set_index(id_col_u)

            variances = []
            for uid in common_ids:
                for b_col, u_col in mappings:
                    try:
                        v_b = df_b_idx.loc[uid, b_col]
                        v_u = df_u_idx.loc[uid, u_col]
                    except KeyError:
                        continue
                    if str(v_b).strip() != str(v_u).strip():
                        variances.append({
                            "ID": uid,
                            "Field": f"{b_col} → {u_col}",
                            "Base_Value": v_b,
                            "Upgraded_Value": v_u,
                        })

            output_name = f"Audit_Report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx"
            with pd.ExcelWriter(output_name, engine="openpyxl") as writer:
                pd.DataFrame(variances).to_excel(writer, sheet_name="Variances", index=False)
                missing.to_excel(writer, sheet_name="Removed_Items", index=False)
                new_items.to_excel(writer, sheet_name="New_Items", index=False)

            self.log(f"Report saved → {output_name}", "ok")
            self.log(f"  Variances: {len(variances)}   |   Removed: {len(missing)}   |   New: {len(new_items)}")

            try:
                if os.name == "nt":
                    os.startfile(output_name)
                elif sys.platform == "darwin":
                    os.system(f'open "{output_name}"')
                else:
                    os.system(f'xdg-open "{output_name}"')
            except Exception as e:
                self.log(f"(Could not auto-open file: {e})", "warn")

        except Exception as e:
            self.log(f"FATAL: {e}", "err")


